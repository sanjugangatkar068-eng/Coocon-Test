# SilkCocoonAI Environment Configuration
# Copy this file to .env and insert your real credentials.
# NEVER commit your real .env file with secrets to Git or GitHub.

# Multimodal Vision AI: Sarvam AI API subscription key
# Create one in your Sarvam dashboard: https://dashboard.sarvam.ai
# The key is sent as the `api-subscription-key` header.
SARVAM_API_KEY=your_sarvam_api_key_here

# Selected Multimodal Model (Default: gemma4)
#
# `gemma4` (Gemma 4 31B) is the image-capable Sarvam model — it accepts text
# AND images, so it is the one used to read cocoon photographs.
# The other Sarvam chat models are text-only and cannot grade a photo:
#   sarvam-105b, sarvam-105b-conversations, glm5.3, deepseekv4.1-flash
#
# NOTE: the image endpoint is served on Sarvam's Chat Completion V2 (beta)
# route, which must be enabled for your API key. Request access from Sarvam
# if gemma4 is not listed for your key.
SARVAM_MODEL=gemma4

# Maximum Upload File Size Limit in Megabytes (Default: 10)
MAX_UPLOAD_SIZE_MB=10

# Optional overrides (leave commented unless you self-host or proxy)
# SARVAM_CHAT_URL=https://api.sarvam.ai/v2/chat/completions
# SARVAM_MODELS_URL=https://api.sarvam.ai/v2/models
